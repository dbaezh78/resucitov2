  "lder": [
    {
      "line": "Sublime es el Señor,, (Do,,10)(Mi,,177)",
      "sC": "tc"
    },
    {
      "line": "que mira hacia el humilde,, (Re,m9,213)",
      "sC": ""
    },
    {
      "line": "conoce al soberbio, le mira desde lejos., (Sol,,34)(Mi,,337)",
      "sC": ""
    },
    {
      "line": "Mas cuando yo camino, ",
      "sC": ""
    },
    {
      "line": "en medio de la angustia,, (Re,m9,193)",
      "sC": ""
    },
    {
      "line": "extiende su mano y su diestra me salva., (Fa,,11)(Mi,,342)",
      "sC": ""
    },
