  "lder": [
    {
      "line": "Bajó deprisa Zaqueo, (La,m,20)",
      "sC": "tc"
    },
    {
      "line": "y le recibió lleno de alegría., (Sol,,238)",
      "sC": ""
    },
    {
      "line": "Al verlo, todos murmuraban:, (Fa,,222)",
      "sC": ""
    },
    {
      "line": "«Ha entrado en casa de un pecador»., (Mi,,320)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Zaqueo, se puso en pie y dijo al Señor:, (La,m,20)",
      "sC": ""
    },
    {
      "line": "«Daré, Señor, la mitad de mis bienes a los pobres;, (Sol,,393)",
      "sC": "ajustar"
    },
    {
      "line": "y si en algo defraudé, el cuádruplo le devolveré»., (Fa,,74)(Mi,,438)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y Jesús le dijo:, (La,m,20)",
      "sC": ""
    },
    {
      "line": "Hoy ha llegado la salvación a esta casa,, (La,m,20)(Sol,,345)",
      "sC": "tc"
    },
    {
      "line": "hoy ha llegado la salvación a esta casa., (Fa,,15)(Mi,,343)",
      "sC": ""
    },
    {
      "line": "HOY HA LLEGADO LA SALVACIÓN A ESTA CASA,, (La,m,20)(Sol,,409)",
      "sC": "ta as"
    },
    {
      "line": "HOY HA LLEGADO LA SALVACIÓN A ESTA CASA»., (Fa,,20)(Mi,,413)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "«Porque también este es hijo de Abraham,, (Re,m,22)(Mi,,371)",
