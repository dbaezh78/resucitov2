    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y yo no me resistí, no me resistí., (Re,,10)(Fa#,m,166)",
      "sC": "tc"
    },
    {
      "line": "Ofrecí mis espaldas a los que me pegaban., (Re,,54)(Sol,,143)(Fa#,,365)",
