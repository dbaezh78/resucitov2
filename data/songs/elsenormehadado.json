    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y YO NO ME RESISTÍ, NO ME RESISTÍ., (Re,,10)(Fa#,m,185)",
      "sC": "ta as"
    },
    {
      "line": "Ofrecí mis mejillas a los que mesaban mi barba., (Re,,12)(Sol,,142)(Fa#,,418)",
      "sC": "tc"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y YO NO ME RESISTÍ, NO ME RESISTÍ., (Re,,10)(Fa#,m,185)",
      "sC": "ta as"
    },
    {
      "line": "Mi rostro no esquivó insultos ni salivazos., (Re,,12)(Fa#,m,364)",
      "sC": "tc"
    }
  ],
  "lder": [
    {
      "line": "Porque yo ya sabía, (Si,m,19)(Do,,165)",
      "sC": "tc"
    },
    {
      "line": "que tú habrías de ayudarme,, (Si,m,227)",
      "sC": ""
