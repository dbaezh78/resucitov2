      "sC": ""
    },
    {
      "line": "dura como la piedra,, (Si,m,159)",
      "sC": ""
    },
    {
      "line": "estaba yo seguro, (Do,,159)",
      "sC": ""
    },
    {
      "line": "que no quedaría avergonzado., (Si,m,259)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
