  "lizq": [
    {
      "line": "A ti, oh Dios, te alabamos,, (Re,,10)",
      "sC": "tc"
    },
    {
      "line": "a ti, Señor, te reconocemos., (La,,26)",
      "sC": ""
    },
    {
      "line": "A ti, Eterno Padre,, (Si,m,26)",
      "sC": ""
    },
    {
      "line": "te venera toda la creación., (Fa#,,53)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "A TI CANTAN LOS ÁNGELES,, (Re,,12)",
      "sC": "ta as"
    },
    {
      "line": "Y TODAS LAS POTENCIAS DEL CIELO:, (La,,36)",
      "sC": "as"
    },
    {
      "line": "SANTO, SANTO, SANTO,, (Si,m,18)",
      "sC": "as"
    },
    {
      "line": "SANTO, SANTO, SANTO,, (Fa#,,14)",
      "sC": "as"
    },
    {
      "line": "EL SEÑOR, DIOS DEL UNIVERSO., (Si,m,259)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Los cielos y la tierra están llenos, (Re,,22)",
      "sC": "tc"
    },
    {
      "line": "de la majestad de tu gloria. ",
      "sC": ""
    },
    {
      "line": "A ti te ensalza el glorioso, (La,,20)",
      "sC": ""
    },
    {
      "line": "coro de los apóstoles, ",
      "sC": ""
    },
    {
      "line": "la multitud adorable de los profetas,, (Si,m,20)",
      "sC": ""
    },
    {
      "line": "el cándido ejército de los mártires., (Fa#,m,15)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "A ti la Iglesia santa, extendida por toda la tierra,, (Re,,22)",
      "sC": ""
    },
    {
      "line": "te proclama: Padre de inmensa majestad,, (La,,20)",
      "sC": ""
    },
    {
      "line": "Hijo único y verdadero, digno de adoración,, (Si,m,20)",
      "sC": ""
    },
    {
      "line": "Espíritu Santo, Defensor., (Fa#,m,15)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
