  "lder": [
    {
      "line": "Tú eres el Rey de la gloria, Cristo. ",
      "sC": "tc s1"
    },
    {
      "line": "Tú eres el Hijo único del Padre. ",
      "sC": "s1"
    },
    {
      "line": "Tú, para liberar al hombre, ",
      "sC": "s1"
    },
    {
      "line": "aceptaste la condición humana, ",
      "sC": "s1"
    },
    {
      "line": "sin desdeñar el seno de la Virgen. ",
      "sC": "s1"
    },
    {
      "line": "Tú, rotas las cadenas de la muerte, ",
      "sC": "s1"
    },
    {
      "line": "abriste a los creyentes el reino de los cielos. ",
      "sC": "s1"
    },
    {
      "line": "Tú te sientas a la derecha de Dios, ",
      "sC": "s1"
    },
    {
      "line": "en la gloria del Padre. ",
      "sC": "s1"
    },
    {
      "type": "collapsible-block",
      "id": "asamblea_anadie_1",
      "initialState": "collapsed",
      "triggerLine": "A TI CANTAN LOS ÁNGELES (Re,,12)",
      "sC": "ta as",
      "lines": [
        {
          "line": "Y TODAS LAS POTENCIAS DEL CIELO:, (La,,36)",
          "sC": "as"
        },
        {
          "line": "SANTO, SANTO, SANTO,, (Si,m,18)",
          "sC": "as"
        },
        {
          "line": "SANTO, SANTO, SANTO,, (Fa#,,14)",
          "sC": "as"
        },
        {
          "line": "EL SEÑOR, DIOS DEL UNIVERSO., (Si,m,259)",
          "sC": "as"
        }
      ]
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Creemos que un día, ",
      "sC": "tc s1"
    },
    {
      "line": "has de venir como juez. ",
      "sC": "s1"
    },
    {
      "line": "Te rogamos, que vengas en ayuda de tus siervos, ",
      "sC": "s1"
    },
    {
      "line": "a quienes redimiste con tu preciosa sangre. ",
      "sC": "s1"
    },
    {
      "line": "Haz que en la gloria eterna, ",
      "sC": "s1"
    },
    {
      "line": "nos asociemos a tus santos. ",
      "sC": "s1"
    },
    {
      "line": "Salva a tu pueblo, Señor, y bendice tu heredad. ",
      "sC": "s1"
    },
    {
      "line": "Sé su pastor, ensálzalo eternamente. ",
      "sC": "s1"
    },
    {
      "type": "collapsible-block",
      "id": "asamblea_anadie_1",
      "initialState": "collapsed",
      "triggerLine": "A TI CANTAN LOS ÁNGELES (Re,,12)",
