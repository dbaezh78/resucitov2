  "lder": [
    {
      "line": "Tenían un corazón, (Re,m,22)",
      "sC": "tc"
    },
    {
      "line": "como tú, como yo,, (Fa,,71)",
      "sC": ""
    },
    {
      "line": "que una mano de hielo oprimía,, (Si♭,,112)",
      "sC": ""
    },
    {
      "line": "tenían los ojos llenos de lágrimas., (Fa,,35)(La,7,248)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Pensaban sin duda en el amigo perdido,, (Re,m,22)(Fa,,351)",
      "sC": ""
    },
    {
      "line": "en la mujer dejada en la puerta de la casa,, (Si♭,,97)",
      "sC": ""
    },
    {
      "line": "en la cruz levantada en la cima del monte., (Fa,,74)(La,7,267)",
      "sC": ""
    },
