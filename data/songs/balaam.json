  "lizq": [
    {
      "line": "De Aram me ha hecho venir, (Mi,m,22)(Re,,255)",
      "sC": "tc"
    },
    {
      "line": "Balaq, el rey de Moab,,(Mi,m,41)(Re,,192)",
      "sC": ""
    },
    {
      "line": "desde los montes de Oriente:, (Mi,m,238)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "«Ven y maldice a Jacob;, (Re,,25)(Mi,m,204)",
      "sC": ""
    },
    {
      "line": "ven y profetiza contra Israel»., (Re,,15)(Mi,m,250)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "¿Cómo maldeciré, si Dios no quiere?, (Sol,,10)(Re,,168)(Sol,,216)(Si,m,258)(Mi,m,310)",
      "sC": ""
    },
    {
      "line": "¿Cómo profetizaré, si Dios no me deja?, (Sol,,10)(Re,,168)(Sol,,216)(Si,m,258)(Mi,m,342)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "De lo alto de esta cima yo diviso,,(Re,,67)(Mi,m,284)",
      "sC": ""
    },
    {
      "line": "desde lo alto de esta roca yo contemplo:, (Re,,94)(Mi,m,330)",
      "sC": ""
    },
    {
      "line": "este es un pueblo distinto, (Re,,11)",
      "sC": ""
    },
    {
      "line": "a todas las naciones., (Mi,m,155)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "¡QUÉ BELLAS SON TUS TIENDAS,,(Mi,m,19)(Re,,246)",
      "sC": "ta as"
    },
    {
      "line": "QUÉ BELLAS SON, ISRAEL!, (Mi,m,230)",
