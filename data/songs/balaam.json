      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Escucha, hijo de Sippor, pon el oído rey Balaq;, (Sol,,13)(Re,,205)(Sol,,312)(Si,m,346)(Mi,m,419)",
      "sC": "tc"
    },
    {
      "line": "que Dios no es un hombre, (Re,,67)",
