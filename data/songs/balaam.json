      "line": "que dice y se arrepiente., (Mi,m,197)",
      "sC": ""
    },
    {
      "line": "Una estrella surge de Jacob,,(Re,,86)(Mi,m,241)",
      "sC": ""
    },
    {
      "line": "se oyen aclamaciones por su Rey., (Re,,36)(Mi,m,300)",
      "sC": ""
    },
    {
      "line": "Dios es su Padre., (Re,,25)(Mi,m,123)",
