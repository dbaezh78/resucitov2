  "lizq": [
    {
      "line": "¡Oh admirable condescendencia de tu amor!, (La,m,20)(Sol,,261)(La,m,406)",
      "sC": ""
    },
    {
      "line": "¡Oh incomparable ternura y caridad!,, (Do,,136)(La,m,324)",
      "sC": ""
    },
    {
      "line": "por rescatar al esclavo has sacrificado al Hijo., (Sol,,100)(La,m,413)",
      "sC": ""
    },
    {
      "line": "Sin el pecado de Adán,, (Fa,,10)(Mi,7,194)",
      "sC": ""
    },
    {
      "line": "Cristo no nos habría rescatado., (Fa,,10)(Mi,7,260)",
      "sC": ""
    },
    {
      "line": "¡OH FELIZ CULPA QUE MERECIÓ, (La,m,20)",
      "sC": "tc as"
    },
    {
      "line": "TAN GRANDE REDENTOR!, (Sol,,213)",
      "sC": "as r4"
    },
    {
      "line": "¡OH FELIZ CULPA!, (La,m,117)",
      "sC": "as"
    },
    {
      "line": "¡Oh noche maravillosa, (La,m,20)(Sol,,187)",
      "sC": ""
    },
    {
      "line": "en que despojaste al Faraón, ",
      "sC": ""
    },
    {
      "line": "y enriqueciste a Israel!, (La,m,195)",
      "sC": ""
    },
    {
      "line": "¡Oh noche maravillosa,, (La,m,20)(Sol,,186)",
      "sC": ""
    },
    {
      "line": "tú sola conociste la hora, ",
      "sC": ""
    },
    {
      "line": "en que Cristo resucitó!, (La,m,202)",
      "sC": ""
    },
    {
      "line": "¡Oh noche que destruyes el pecado, (La,m,20)(Sol,,304)",
      "sC": ""
    },
    {
      "line": "y lavas todas nuestras culpas!, (La,m,239)",
      "sC": ""
    },
    {
      "line": "¡Oh noche realmente gloriosa, (La,m,20)(Sol,,258)",
      "sC": ""
    },
    {
      "line": "que reconcilias, (Fa,,111)",
      "sC": ""
    },
    {
      "line": "al hombre con su Dios!, (Mi,7,195)",
      "sC": ""
    }
  ],
  "lder": [
    {
      "line": "ESTA ES LA NOCHE, (La,m,20)",
      "sC": "ta as"
    },
    {
      "line": "EN QUE CRISTO HA VENCIDO LA MUERTE, (Sol,,347)",
      "sC": "as r5"
    },
    {
      "line": "Y DEL INFIERNO RETORNA VICTORIOSO., (Fa,,105)(Mi,,344)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "En esta noche acepta, Padre Santo,, (La,m,20)(Sol,,300)",
      "sC": "tc"
    },
    {
      "line": "este sacrificio de alabanza que la Iglesia, (La,m,218)(Do,,354)",
      "sC": ""
    },
    {
      "line": "te ofrece por medio de sus ministros, (La,m,302)",
      "sC": ""
    },
    {
      "line": "en la liturgia solemne de este cirio,, (Sol,,77)",
      "sC": ""
    },
    {
      "line": "que es el signo de la nueva luz., (La,m,278)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Te rogamos, Señor, que este cirio, (Fa,,10)(Mi,7,165)(La,m,295)",
      "sC": ""
    },
    {
      "line": "ofrecido en el honor de tu nombre, (Sol,,271)",
      "sC": ""
    },
    {
      "line": "brille radiante;, (La,m,94)",
      "sC": ""
    },
    {
      "line": "llegue hasta ti, como perfume suave,, (Sol,,321)",
      "sC": ""
    },
    {
      "line": "se confunda con las estrellas del cielo., (La,m,341)",
      "sC": ""
    },
    {
      "line": "Lo encuentre encendido el lucero de la mañana,, (Sol,,424)",
      "sC": ""
    },
    {
      "line": "esa estrella que no conoce el ocaso., (Fa,,79)(Mi,7,317)",
      "sC": ""
    },
    {
