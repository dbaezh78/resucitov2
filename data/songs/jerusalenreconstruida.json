      "sC": ""
    },
    {
      "line": "sus torres con oro puro., (Mi,m,194)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Sus plazas serán de rubí,, (Re,,232)",
