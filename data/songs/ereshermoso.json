    {
      "line": "Escucha, hija, y mira, inclina el oído,, (Do#,m,29)(Sol#,,171)(La,,243)(Sol#,,315)",
      "sC": "tc"
    },
    {
      "line": "olvida tu pueblo y la casa de tu padre,, (Fa#,m,34)(Sol#,,318)",
      "sC": ""
