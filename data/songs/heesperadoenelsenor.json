    },
    {
      "line": "No quisiste sacrificios ni oblación,, (La,m,20)(Mi,m,301)",
      "sC": "tc r2"
    },
    {
      "line": "por eso me has abierto el oído., (La,m,51)(Mi,m,262)",
      "sC": ""
    },
    {
      "line": "No has querido víctima por la culpa,, (Fa,,117)(Mi,7,304)",
      "sC": ""
    },
    {
      "line": "por eso he dicho: he aquí que vengo, (Fa,,119)",
      "sC": ""
    },
    {
      "line": "para hacer tu voluntad., (Mi,7,201)",
