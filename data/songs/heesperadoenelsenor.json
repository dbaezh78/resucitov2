  "lder": [
    {
      "line": "Dios mío, ¡cuántas maravillas,, (La,m,20)(Mi,m,250)",
      "sC": "tc"
    },
    {
      "line": "cuántos prodigios en nuestro favor!, (La,m,35)(Mi,m,320)",
      "sC": ""
    },
    {
      "line": "Si los quiero anunciar y proclamar,, (Fa,,97)(Mi,7,314)",
      "sC": ""
    },
    {
      "line": "son tantos que me superan en número., (Fa,,53)(Mi,,316)",
