      "sC": "as"
    },
    {
      "line": "LAS TINIEBLAS DEL MUNDO., (Mi7,,215)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Que se alegre nuestra madre la Iglesia,, (La,m,20)(Sol,,337)",
      "sC": "tc"
    },
    {
      "line": "resplandeciente de la gloria de su Señor;, (La,m,122)(Do,,236)(La,m,374)",
      "sC": ""
    },
    {
      "line": "y que en este lugar resuene unánime, (Sol,,98)",
      "sC": ""
    },
    {
      "line": "la aclamación de un pueblo en fiesta., (La,m,320)",
      "sC": ""
    },
    {
      "line": "El Señor esté con vosotros., (Sol,,14)(La,m,208)",
      "sC": "tc"
    },
    {
      "line": "Y CON TU ESPÍRITU., (Sol,,14)(La,m,141)",
      "sC": "ta as"
    },
    {
      "line": "Levantemos el corazón., (Fa,,12)(Mi,,202)",
      "sC": "tc"
    },
    {
      "line": "LO TENEMOS LEVANTADO HACIA EL SEÑOR., (Fa,,10)(Mi,,392)",
      "sC": "ta as"
    },
    {
      "line": "Demos gracias al Señor, nuestro Dios., (La,m,340)",
      "sC": "tc"
    },
    {
      "line": "ES JUSTO Y NECESARIO., (Sol,,47)(La,m,188)",
      "sC": "ta as r2"
    }
  ],
  "lder": [
    {
      "line": "Realmente es justo y necesario, (La,m,20)(Sol,,267)",
      "sC": "tc"
    },
    {
      "line": "exaltar con el canto la alegría del espíritu, (La,m,52)(Do,,151)(La,m,361)",
      "sC": ""
    },
    {
      "line": "y elevar un himno al Padre Todopoderoso,, (Sol,,62)",
      "sC": ""
    },
    {
      "line": "y a su único Hijo, Jesucristo., (La,m,230)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Él ha pagado por todos al eterno Padre, (Sol,,336)",
      "sC": ""
    },
    {
      "line": "la deuda de Adán,, (La,m,152)",
      "sC": ""
    },
    {
      "line": "y con su Sangre, derramada por amor,, (Do,,102)(La,m,349)",
      "sC": ""
    },
    {
      "line": "ha cancelado la condena antigua del pecado., (Sol,,97)(La,m,395)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Esta es la Pascua,, (Fa,,10)(Mi7,,118)",
      "sC": ""
    },
    {
      "line": "en que se inmola el Cordero., (Fa,,139)(Mi,,242)",
      "sC": ""
    },
    {
      "line": "Esta es la noche, (Fa,,57)(Mi7,,112)",
      "sC": ""
    },
    {
      "line": "en que fueron liberados, (Fa,,94)",
      "sC": ""
    },
    {
      "line": "nuestros padres de Egipto., (Mi7,,216)",
      "sC": ""
    },
    {
      "line": "Esta es la noche, (Fa,,56)(Mi7,,115)",
      "sC": ""
    },
    {
