      "sC": ""
    },
    {
      "line": "Alégrese la tierra, inundada por la nueva luz., (Fa,,11)(Mi,7,131)(Fa,,235)(Mi,7,412)",
      "sC": ""
    },
    {
      "line": "EL ESPLENDOR DEL REY, (La,m,219)",
