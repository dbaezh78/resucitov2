    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Es signo lo que aparece,, (La,m,20)(Re,m,199)",
      "sC": ""
    },
    {
      "line": "y esconde un gran misterio,, (La,m,231)",
      "sC": ""
