  "lder": [
    {
      "line": "A ti, Señor, miran mis ojos,, (Do,,10)(Fa,,80)(La,7,228)",
      "sC": "tc"
    },
    {
      "line": "en ti me refugio, ¡no desampares mi alma!, (Do,,35)(Si♭,,120)(La,7,367)",
      "sC": ""
    },
    {
      "line": "Guárdame tú del lazo que me tienden,, (Sol,m,22)(La,7,307)",
      "sC": ""
    },
    {
      "line": "de las trampas de tantos enemigos., (Sol,m,87)(La,7,298)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Caigan ellos, cada uno en su red,, (Fa,,10)(Re,m,135)(La,7,294)",
      "sC": ""
    },
    {
      "line": "que yo, unido a ti, paso indemne,, (Si♭,,12)(La,7,265)",
