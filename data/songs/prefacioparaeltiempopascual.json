  "lizq": [
    {
      "line": "El Señor esté con vosotros., (Sol,,14)(La,m,250)",
      "sC": "pa"
    },
    {
      "line": "Y CON TU ESPÍRITU., (Sol,,14)(La,m,250)",
      "sC": "ta as"
    },
    {
      "line": "Levantemos el corazón., (Fa,,20)(Mi,,250)",
      "sC": "pa"
    },
    {
      "line": "LO TENEMOS LEVANTADO HACIA EL SEÑOR., (Fa,,20)(Mi,,250)",
      "sC": "ta as"
    },
    {
      "line": "Demos gracias al Señor, nuestro Dios., (La,m,20)",
      "sC": "pa"
    },
    {
      "line": "ES JUSTO Y NECESARIO., (Sol,,14)(La,m,250)",
      "sC": "ta as r1"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Realmente es justo y necesario,, (La,m,20)(Re,m,130)(La,m,268)",
      "sC": "pa"
    },
    {
      "line": "es nuestro deber y salvación, (Mi,,10)(La,m,256)",
      "sC": ""
    },
    {
      "line": "glorificarte siempre, Señor,, (Re,m,132)(La,m,244)",
      "sC": ""
    },
    {
      "line": "pero más que nunca en este día, (Fa,,10)(La,m,296)",
      "sC": ""
    },
    {
      "line": "en que Cristo, nuestra Pascua,, (Fa,,10)",
      "sC": ""
    },
    {
      "line": "ha sido inmolado., (Mi,,136)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Él es el verdadero cordero, (La,m,20)(Sol,,222)",
      "sC": ""
    },
    {
      "line": "que quitó el pecado del mundo., (La,m,257)",
      "sC": ""
    }
  ],
  "lder": [
    {
      "line": "MURIENDO, (La,m,20)",
      "sC": "pa as"
    },
    {
