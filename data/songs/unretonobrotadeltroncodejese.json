    {
      "line": "No juzgará de oídas,, (Do,,10)(Sol,,149)",
      "sC": "tc"
    },
    {
      "line": "sino que ayudará a los oprimidos., (Re,,10)(Sol,,279)",
      "sC": ""
    },
    {
      "line": "Su palabra será una vara contra el violento, (Do,,65)(Sol,,373)",
      "sC": ""
    },
    {
      "line": "y con el soplo de su boca matará al malvado., (Re,,92)(Sol,,398)",
      "sC": ""
    },
    {
      "line": "El lobo vivirá con el cordero,, (Do,,34)(Sol,,235)",
      "sC": ""
    },
    {
      "line": "la pantera se echará con el cabrito,, (Do,,71)(Sol,,309)",
      "sC": ""
    },
    {
      "line": "el león y el novillo pacerán juntos,, (Re,,45)(Sol,,269)",
      "sC": ""
    },
    {
      "line": "y un niño los guiará, y un niño los guiará., (Do,,57)(Sol,,176)(Re,,258)(Sol,,376)",
      "sC": ""
    },
