    },
    {
      "line": "Cuando salías de Seír, Yahveh, Dios mío,, (Re,7,22)",
      "sC": "tc"
    },
    {
      "line": "cuando avanzabas por los campos de Edom, ",
      "sC": "s1"
    },
    {
      "line": "tembló la tierra, se estremeció el cielo, ",
      "sC": "s1"
    },
    {
      "line": "las nubes en agua se fundieron, ",
      "sC": "s1"
    },
    {
      "line": "delante de Ti los montes se licuaron, ",
      "sC": "s1"
    },
    {
      "line": "delante de Ti, Dios de Israel. ",
      "sC": "s1"
    },
    {
      "line": "Desde los cielos lucharon las estrellas, ",
      "sC": ""
    },
    {
      "line": "DESDE LOS CIELOS, ",
      "sC": "ta as"
    },
    {
      "line": "LUCHARON LAS ESTRELLAS, ",
      "sC": "as"
    },
    {
      "line": "Desde los cielos lucharon contra Sísara, ",
      "sC": "tc"
    },
    {
      "line": "DESDE LOS CIELOS, ",
      "sC": "ta as"
    },
    {
      "line": "LUCHARON CONTRA SÍSARA, ",
      "sC": "as"
    },
    {
      "line": "el torrente Quisón, ",
      "sC": "tc"
    },
    {
      "line": "el torrente sagrado los barrió. ",
      "sC": "s1"
