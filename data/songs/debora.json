    },
    {
      "line": "En los días de Samgar, hijo de Anat,, (Re,7,22)",
      "sC": "tc"
    },
    {
      "line": "en los días de Yael, ",
      "sC": "s1"
    },
    {
      "line": "ya no había caravanas, ",
      "sC": "s1"
    },
    {
      "line": "no se podía andar por los caminos, ",
      "sC": "s1"
    },
    {
      "line": "porque Israel se había buscado otros dioses, ",
      "sC": "s1"
    },
    {
      "line": "por eso la guerra era a sus puertas, ",
      "sC": "s1"
    },
    {
      "line": "y no había guerrero en Israel, ",
      "sC": "s1"
    },
    {
      "line": "no se encontraba una lanza entre diez mil. ",
      "sC": "s1"
    }
