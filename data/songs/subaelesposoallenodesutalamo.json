  "lder": [
    {
      "line": "¡Oh, qué grande el sacramento de estas bodas!, (Re,,12)(Mi,,405)",
      "sC": "tc"
    },
    {
      "line": "¡Qué misterio este Esposo y esta Esposa!, (Re,m,99)(Mi,,355)",
      "sC": ""
    },
    {
      "line": "La Esposa toma el velo, (Re,m,78)",
      "sC": ""
    },
    {
      "line": "cuando muere el Esposo,, (Fa,,206)",
      "sC": ""
    },
    {
      "line": "y el Esposo se une a la Esposa, (Fa,,76)(Re,m,266)",
      "sC": ""
    },
    {
      "line": "cuando de la muerte se separa., (Mi,,274)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y cuando el Esposo es elevado a los Cielos,, (Fa,,46)",
      "sC": ""
    },
    {
      "line": "la Esposa se hace fecunda en toda la tierra., (Mi,,379)",
