    },
    {
      "line": "demos vítores a la roca que nos salva;, (Si,7,82)(Mi,,327)",
      "sC": ""
    },
    {
      "line": "entremos a su presencia dándole gracias,, (Do#,m,195)(Sol#,,349)",
      "sC": ""
    },
    {
      "line": "aclamándolo con cantos y salmos., (Do#,m,280)(Mi,,331)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
