    },
    {
      "line": "suyo es el mar, suya es la tierra,, (Do#,m,26)(Sol#,,269)",
      "sC": ""
    },
    {
      "line": "son suyas las cumbres de los montes., (Do#,m,310)(Mi,,361)",
