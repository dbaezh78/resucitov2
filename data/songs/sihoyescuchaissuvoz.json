  ],
  "lder": [
    {
      "line": "¡Ojalá! ¡Ojalá escuchéis hoy su voz, (Do#,m,26)(Sol#,,113)",
      "sC": "tc"
    },
    {
      "line": "y no endurezcáis el corazón!, (Do#,m,245)",
      "sC": ""
    },
    {
      "line": "Como en Meribá,, (Fa#,m,25)",
      "sC": ""
    },
    {
      "line": "como el día de Masá en el desierto,, (Si,7,99)(Mi,,298)",
      "sC": ""
    },
    {
      "line": "donde vuestros padres dudaron de mí,, (Do#,m,177)(Sol#,,353)",
      "sC": ""
    },
    {
      "line": "aunque habían visto mis obras, ",
      "sC": ""
    },
    {
      "line": "me obligaron a hacer su voluntad., (Do#,m,299)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Durante cuarenta años, (Fa#,m,25)",
      "sC": ""
    },
    {
      "line": "me disgustó aquella generación., (Si,7,110)(Mi,,285)",
      "sC": ""
    },
    {
      "line": "Y dije «Este es un pueblo, (Do#,m,25)",
      "sC": ""
    },
    {
      "line": "de corazón extraviado,, (Sol#,,180)",
      "sC": ""
    },
    {
      "line": "no quiere conocer mis caminos, ",
      "sC": ""
    },
    {
      "line": "por eso no entrarán en mi descanso»., (Do#,m,305)(Mi,,362)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
