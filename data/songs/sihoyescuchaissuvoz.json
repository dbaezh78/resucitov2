    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Entrad, postrémonos por tierra,, (Do#,m,26)(Fa#,m,264)",
      "sC": "tc"
    },
    {
      "line": "bendiciendo al Señor, creador nuestro., (Si,7,27)(Mi,,264)",
      "sC": ""
    },
    {
      "line": "Porque El es nuestro Dios y nosotros su pueblo,, (Do#,m,81)(Sol#,,321)",
      "sC": ""
    },
    {
      "line": "el rebaño que Él conduce., (Do#,m,227)(MI,,275)",
      "sC": ""
    },
    {
