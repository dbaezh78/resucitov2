    {
      "line": "Con un mismo amor,, (Mi,m,20)",
      "sC": "tc"
    },
    {
      "line": "con un mismo espíritu,, (Si,7,183)",
      "sC": ""
    },
    {
      "line": "con los mismos sentimientos., (Mi,m,231)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Nada por rivalidad,, ",
      "sC": ""
    },
    {
      "line": "ni por vanagloria,, (Si,7,131)",
      "sC": ""
    },
    {
      "line": "mas todo con humildad., (Mi,m,210)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Considerando a los otros como superiores a ti,, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "no buscando tu propio interés,, (Si,7,273)",
      "sC": ""
    },
    {
      "line": "teniendo los sentimientos de Jesús., (Mi,m,319)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "El cual, siendo Dios,, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "no retuvo ávidamente su dignidad,, (Si,7,308)",
      "sC": ""
    },
    {
      "line": "sino que se hizo hombre., (Mi,m,180)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y hecho hombre, se humilló a sí mismo,, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "tomando condición de esclavo,, (Si,7,265)",
      "sC": ""
    },
    {
      "line": "obedeciendo hasta la muerte., (Mi,m,250)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "¡Y qué muerte!:, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "muerte de pecador, muerte de malhechor,, (La,m,93)(Mi,m,169)(La,m,287)(Mi,m,387)",
      "sC": ""
    },
    {
      "line": "¡muerte de cruz!, (Si,7,47)",
      "sC": ""
    }
  ],
