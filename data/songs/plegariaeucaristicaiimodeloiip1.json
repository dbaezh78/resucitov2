  "lizq": [
    {
      "line": "El Señor esté con vosotros., (La,m,20)(Sol,,119)(La,m,212)",
      "sC": "pa"
    },
    {
      "line": "Y CON TU ESPÍRITU., (Sol,,39)(La,m,141)",
      "sC": "ta as"
    },
    {
      "line": "Levantemos el corazón., (Sol,,204)",
      "sC": "pa"
    },
    {
      "line": "LO TENEMOS LEVANTADO HACIA EL SEÑOR., (La,m,389)",
      "sC": "ta as"
    },
    {
      "line": "Demos gracias al Señor, nuestro Dios., (Sol,,14)(La,m,336)",
      "sC": "pa"
    },
    {
      "line": "ES JUSTO Y NECESARIO., (Sol,,14)(La,m,186)",
      "sC": "ta as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Verdaderamente,, (La,m,20)",
      "sC": "pa ast"
    },
    {
      "line": "es justo y necesario,, (Sol,,44)",
      "sC": ""
    },
    {
      "line": "es nuestro deber y fuente de salvación, (La,m,352)",
      "sC": ""
    },
    {
      "line": "darte gracias, siempre y en todo lugar., (Sol,,14)(La,m,158)",
      "sC": ""
    },
    {
      "line": "A ti, Padre Santo, ",
      "sC": "ast1"
    },
    {
      "line": "por Jesucristo, tu amadísimo Hijo., (Sol,,104)(La,m,303)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Por Él, que es tu Palabra viviente,, (Sol,,279)",
      "sC": "ast2"
    },
    {
      "line": "hiciste todas las cosas;, (La,m,182)",
      "sC": ""
    },
    {
      "line": "tú nos lo enviaste Salvador y Redentor, (Fa,,131)(La,m,195)",
      "sC": ""
    },
    {
      "line": "hecho hombre por obra del Espíritu Santo,, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "y nacido de la Virgen María,, (La,m,246)",
      "sC": ""
    }
  ],
  "lder": [
    {
      "line": "para cumplir tu voluntad, (Sol,,14)(La,m,221)",
      "sC": ""
    },
    {
      "line": "y adquirir para Ti un pueblo santo. ",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Él,",
      "sC": "ast3"
    },
    {
      "line": "extendió sus brazos en la cruz,, (Sol,,75)(La,m,270)",
      "sC": ""
    },
    {
      "line": "muriendo destruyó la muerte.,(Sol,,50)(La,m,251) ",
      "sC": ""
    },
    {
      "line": "Y proclamó, ",
      "sC": ""
    },
    {
      "line": "la resurrección.,(Sol,,14)(La,m,126) ",
      "sC": ""
    },
    {
