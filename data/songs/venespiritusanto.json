  ],
  "lder": [
    {
      "line": "Lava lo que está sucio, ",
      "sC": "tc ptop0"
    },
    {
      "line": "riega lo que está árido, ",
      "sC": "ptop0"
    },
    {
      "line": "sana lo que está enfermo. ",
      "sC": "ptop0"
    },
    {
      "line": "Convierte al duro y al rígido. ",
      "sC": "ptop0"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "type": "collapsible-block",
