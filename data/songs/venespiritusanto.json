    {
      "line": "Ven, dulce refrigerio, ",
      "sC": "tc ptop0"
    },
    {
      "line": "en la fatiga tú eres descanso; ",
      "sC": "ptop0"
    },
    {
      "line": "en el calor tú eres nuestro alivio; ",
      "sC": "ptop0"
    },
    {
      "line": "en el llanto eres consuelo. ",
      "sC": "ptop0"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "type": "collapsible-block",
