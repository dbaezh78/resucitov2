          "sC": "as"
        }
      ]
    },
    {
      "line": "Inflama lo que está tibio, ",
      "sC": "tc ptop0"
    },
    {
      "line": "encamina al que se ha extraviado. ",
      "sC": "ptop0"
    },
    {
      "line": "Danos tus siete dones, ",
      "sC": "ptop0"
    },
    {
      "line": "danos tu amor y tu alegría. ",
      "sC": "ptop0"
    },
    {
      "line": "",
