      "sC": "sub",
      "color": "gray"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Dios es nuestro refugio y nuestra fuerza,, (Mi,m,20)(Sol,,346)",
      "sC": "tc"
    },
    {
      "line": "Poderoso defensor en el peligro., (La,,20)(Mi,m,272)",
      "sC": ""
    },
    {
      "line": "POR ESO NO TEMEMOS AUNQUE TIEMBLE LA TIERRA,, (Mi,m,20)(Sol,,449)",
      "sC": "ta as width"
    },
    {
      "line": "Y LOS MONTES SE DESPLOMEN EN EL MAR., (La,,20)(Mi,m,403)",
      "sC": "as width"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Que hiervan y bramen sus olas,, (Sol,,14)(Mi,m,275)",
      "sC": "tc"
    },
    {
      "line": "que sacudan a los montes con su furia., (La,,20)(Mi,m,341)",
      "sC": ""
    },
    {
      "line": "EL SEÑOR DE LOS EJÉRCITOS ESTÁ CON NOSOTROS,, (Mi,m,20)(Sol,,426)",
      "sC": "ta as width"
    },
    {
      "line": "NUESTRO ALCÁZAR ES EL DIOS DE JACOB., (La,,20)(Mi,m,380)",
