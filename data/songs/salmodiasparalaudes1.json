      "line": "Escuchad, cielos, y hablaré,, (La,m,20)(Mi,,251)",
      "sC": "tc"
    },
    {
      "line": "oye, tierra, los dichos de mi boca:, (Re,m,22)(Mi,,282)",
      "sC": ""
    },
    {
      "line": "DESCIENDA COMO LLUVIA MI DOCTRINA,, (La,m,20)(Mi,,360)",
      "sC": "ta as"
    },
    {
      "line": "DESTILE COMO ROCÍO MI PALABRA., (Re,m,22)(Mi,,294)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "SALMODIA V, ",
      "sC": "negrita",
      "color": "var(--Rojo-Leccionario)"
    },
    {
