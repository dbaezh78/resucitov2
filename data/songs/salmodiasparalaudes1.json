    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "SALMODIA II, ",
      "sC": "negrita",
      "color": "var(--Rojo-Leccionario)"
    },
    {
      "line": "Is 38, ",
      "sC": "sub",
      "color": "gray"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Levantan y enrollan mi vida, (La,m,20)(Sol,,236)",
      "sC": "tc"
    },
    {
      "line": "como una tienda de pastores., (La,m,247)",
      "sC": ""
    },
    {
      "line": "COMO UN TEJEDOR, DEVANABA YO MI VIDA,, (Sol,,14)(La,m,387)",
      "sC": "ta as"
    },
    {
      "line": "Y ME CORTAN LA TRAMA., (Sol,,14)(La,m,197)",
      "sC": "as"
    },
    {
      "line": "Día y noche me estás acabando,, (La,m,17)",
      "sC": "tc"
    },
    {
      "line": "sollozo hasta el amanecer., (Sol,,14)(La,m,235)",
      "sC": "tc"
    },
    {
      "line": "ME QUIEBRAS LOS HUESOS COMO UN LEÓN,, (Sol,,14)(La,m,398)",
      "sC": "ta as"
    },
    {
      "line": "DÍA Y NOCHE ME ESTÁS ACABANDO., (Sol,,14)(La,m,295)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "SALMODIA III, ",
      "sC": "negrita",
      "color": "var(--Rojo-Leccionario)"
    },
    {
      "line": "Sal 43 [42], ",
      "sC": "sub",
      "color": "gray"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Tú eres mi Dios y protector,, (Re,m,22)(Sol,m,244)",
      "sC": "tc"
    },
    {
      "line": "¿por qué me rechazas?,, (Re,m,22)",
      "sC": ""
    },
    {
      "line": "¿POR QUÉ VOY ANDANDO SOMBRÍO,, (Re,m,22)(Sol,m,329)",
      "sC": "ta as"
    },
    {
      "line": "HOSTIGADO POR MI ENEMIGO?, (Re,m,259)",
      "sC": "as"
    }
  ],
  "lder": [
    {
