      "sC": "ta as"
    },
    {
      "line": "Nuestros delitos nos abruman,, (Re,m,22)(La,7,233)",
      "sC": "tc"
    },
    {
      "line": "PERO TÚ LOS PERDONAS., (Si♭,7,17)(La,7,191)",
