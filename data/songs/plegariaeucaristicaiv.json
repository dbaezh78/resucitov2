        },
        {
          "line": "Santo, Santo, Santo., (La,m,18)(Sol,,78)(La,m,152)",
          "sC": "tc"
        },
        {
          "line": "SANTO, SANTO, SANTO., (Sol,,84)(La,m,162)",
          "sC": "ta as"
        },
        {
          "line": "",
          "sC": "adb1"
        },
        {
          "line": "Los cielos y la tierra, (La,m,19)(Sol,,150)",
          "sC": "tc"
        },
        {
          "line": "están llenos de tu Gloria., (La,m,15)",
          "sC": ""
        },
        {
          "line": "LOS CIELOS Y LA TIERRA, (Sol,,197)",
          "sC": "ta as"
        },
        {
          "line": "ESTÁN LLENOS DE TU GLORIA., (La,m,181)",
          "sC": "as"
        },
        {
          "line": "",
          "sC": "adb1"
        },
        {
          "line": "Hosanna en lo alto del Cielo., (Fa,,45)(Mi,,240)",
          "sC": "tc"
        },
        {
          "line": "HOSANNA EN LO ALTO DEL CIELO., (Fa,,46)(Mi,,288)",
          "sC": "ta as"
        },
        {
          "line": "",
          "sC": "adb1"
        },
        {
          "line": "SANTO, SANTO, SANTO., (La,m,20)(Sol,,90)(La,m,173)",
          "sC": "ta as"
        },
        {
          "line": "SANTO, SANTO, SANTO., (Sol,,90)(La,m,175)",
          "sC": "as"
        },
        {
          "line": "Bendito es el que viene, (La,m,15)(Sol,,193)",
          "sC": "tc"
        },
        {
          "line": "en el nombre del Señor., (La,m,212)",
          "sC": ""
        },
        {
          "line": "BENDITO ES EL QUE VIENE, (Sol,,223)",
          "sC": "ta as"
        },
        {
          "line": "EN EL NOMBRE DEL SEÑOR., (La,m,244)",
          "sC": "as"
        },
        {
          "line": "",
          "sC": "adb1"
        },
        {
          "line": "Hosanna en lo alto del Cielo., (Fa,,38)(Mi,,242)",
          "sC": "tc"
        },
        {
          "line": "HOSANNA EN LO ALTO DEL CIELO., (Fa,,48)(Mi,,291)",
          "sC": "ta as"
        },
        {
          "line": "",
          "sC": "adb1"
        },
        {
          "line": "SANTO, SANTO, SANTO., (La,m,20)(Sol,,90)(La,m,173)",
          "sC": "ta as"
        },
        {
          "line": "SANTO, SANTO, SANTO., (Sol,,90)(La,m,175)",
          "sC": "as"
        },
        {
          "line": "",
          "sC": "adb1"
        },
        {
          "line": "Santo, Santo, Santo., (Fa,,14)(Mi,,143)",
          "sC": "tc"
        },
        {
          "line": "SANTO, SANTO, SANTO., (Fa,,13)(Mi,,163)",
          "sC": "ta as"
        }
      ]
    },
    {
      "line": "Transición, ",
      "sC": "ttgray",
      "color": "var(--Referencia-Texto)"
    },
    {
      "line": "Te alabamos, Padre santo, porque eres grande, (La,m,20)(Do,,403)",
      "sC": "pa"
    },
    {
      "line": "y porque hiciste todas las cosas, (Re,,119)",
      "sC": ""
    },
    {
      "line": "con sabiduría y amor., (La,m,189)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "A imagen tuya creaste al hombre, (Do,,260)",
      "sC": ""
    },
    {
      "line": "y le encomendaste el universo entero,, (Re,,148)",
      "sC": ""
    },
    {
      "line": "para que, sirviéndote solo a ti, su Creador,, (Fa,,142)",
      "sC": ""
    },
    {
      "line": "dominara todo lo creado., (Sol,,109)(La,m,205)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y cuando por desobediencia perdió tu amistad,, (Sol,,14)(La,m,430)",
      "sC": ""
    },
    {
      "line": "no lo abandonaste al poder de la muerte,, (Do,,141)",
      "sC": ""
    },
    {
      "line": "sino que, compadecido,, (Re,,193)",
      "sC": ""
    },
    {
      "line": "tendiste la mano a todos,, (Mi,,195)",
      "sC": ""
    },
    {
      "line": "para que te encuentre, (Re,,165)",
      "sC": ""
    },
    {
      "line": "el que te busca, (Mi,,104)",
      "sC": ""
    },
    {
      "line": "Reiteraste tu alianza a los hombres;, (La,m,20)",
      "sC": ""
    },
    {
      "line": "por los profetas los fuiste llevando, (Re,m,22)",
      "sC": ""
    },
    {
      "line": "con la esperanza de la salvación., (Mi,,290)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Padre Santo, tanto amaste al mundo, (Do,,10)",
      "sC": ""
    },
    {
      "line": "que, al cumplirse la plenitud de los tiempos,, (La,m,361)",
      "sC": ""
    },
    {
      "line": "nos enviaste como salvador, (Do,,10)",
      "sC": ""
    },
    {
      "line": "a tu único Hijo., (La,m,122)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "El cual se encarnó, (Do,,168)",
      "sC": ""
    },
    {
      "line": "por obra del Espíritu Santo,, (Re,,10)",
      "sC": ""
    },
    {
      "line": "nació de María, la Virgen,, (La,m,196)",
      "sC": ""
    },
    {
      "line": "y así compartió en todo, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "nuestra condición humana, ",
      "sC": ""
    },
    {
      "line": "menos en el pecado;, (La,m,163)",
      "sC": ""
    },
    {
      "line": "anunció la salvación a los pobres,, (Do,,10)(La,m,268)",
      "sC": ""
    },
    {
      "line": "la liberación a los oprimidos, (Do,,10)",
      "sC": ""
    },
    {
      "line": "y a los afligidos el consuelo., (La,m,238)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Para cumplir tus designios,, (Sol,,200)",
      "sC": ""
    },
    {
      "line": "él mismo se entregó a la muerte, (La,m,282)",
      "sC": ""
    },
    {
      "line": "y, resucitando, destruyó la muerte., (Sol,,90)(La,m,289)",
      "sC": ""
    },
    {
      "line": "RESUCITANDO,, (Do,,10)",
      "sC": "ta as"
    },
    {
      "line": "DESTRUYÓ LA MUERTE, ",
      "sC": "as r2"
    },
    {
      "line": "Y NOS DIO NUEVA VIDA., (La,m,196)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y porque no vivamos ya para nosotros mismos,, (La,m,20)(Do,,389)",
      "sC": "pa"
    },
    {
      "line": "sino para él,, (Re,,104)",
      "sC": ""
    },
    {
      "line": "que por nosotros murió y resucitó,, ",
      "sC": ""
    },
    {
      "line": "envió, Padre, desde tu seno, (La,m,80)",
      "sC": ""
    },
    {
      "line": "al Espíritu Santo, (Sol,,61)(La,m,117)",
      "sC": ""
    },
    {
      "line": "como primicia para los creyentes,, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "a fin de santificar todas las cosas,, ",
      "sC": ""
    },
    {
      "line": "llevando a plenitud su obra en el mundo., (La,m,44)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Epíclesis. Oración Consecratoria",
      "sC": "ttgray",
      "color": "var(--Referencia-Texto)"
    },
    {
      "line": "Y este mismo Espíritu, (Do,,10)",
      "sC": "pa"
    },
    {
      "line": "santifique, Señor,, (Re,,11)",
      "sC": ""
    },
    {
      "line": "estas ofrendas,, (La,m,92)",
      "sC": ""
    },
    {
      "line": "para que sean Cuerpo y   Sangre, (Re,,18)",
      "sC": ""
    },
    {
      "line": "de Jesucristo, nuestro Señor,, (La,m,91)",
      "sC": ""
    },
    {
      "line": "y así celebremos el gran misterio, (Re,,42)",
      "sC": ""
    },
    {
      "line": "que nos dejó, como alianza eterna., (La,m,114)",
      "sC": ""
    },
    {
      "line": "Relato de la Institución",
      "sC": "ttgray",
      "color": "var(--Referencia-Texto)"
    },
    {
      "line": "Porque él mismo, llegada la hora, (Do,,10)",
      "sC": "pa"
    },
    {
      "line": "en que había de ser glorificado por ti, Padre santo,, (La,m,354)",
      "sC": ""
    },
    {
      "line": "habiendo amado a los suyos, (Do,,10)",
      "sC": ""
    },
    {
      "line": "que estaban en el mundo,, ",
      "sC": ""
    },
    {
      "line": "los amó hasta el extremo., (La,m,203)",
      "sC": ""
    },
    {
      "line": "Y, mientras cenaba con sus discípulos,, (Fa,,10)",
      "sC": ""
    },
    {
      "line": "tomó pan, te bendijo,, (La,m,20)",
      "sC": ""
    },
    {
      "line": "lo partió y se lo dio, diciendo:, (Fa,,10)(Sol,,230)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Tomad y comed todos de él,, (La,m,20)(Sol,,168)(La,m,254)",
      "sC": ""
    },
    {
      "line": "porque esto es mi Cuerpo,, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "que será entregado por vosotros., (La,m,265)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Del mismo modo,, (Do,,10)",
      "sC": ""
    },
    {
      "line": "tomó el cáliz lleno del fruto de la vid, ",
      "sC": ""
    },
    {
      "line": "y te dio gracias,, (La,m,97)",
      "sC": ""
    },
    {
      "line": "lo pasó a sus discípulos, diciendo:, (Re,m,22)(Mi,,276)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Tomad y bebed todos de él,, (Sol,,14)(La,m,250)",
      "sC": ""
    },
    {
      "line": "porque este es el cáliz de mi Sangre,, (Sol,,14)",
      "sC": ""
    },
    {
      "line": "Sangre de la alianza nueva y eterna,, (La,m,307)",
      "sC": ""
    },
    {
      "line": "que será derramada por muchos,, (Sol,,13)",
      "sC": ""
    },
    {
      "line": "para el perdón de los pecados., (La,m,248)",
      "sC": ""
    },
    {
      "line": "Haced esto en conmemoración mía., (Fa,,10)(Mi,,325)",
      "sC": ""
    },
    {
      "line": "Aclamación, ",
      "sC": ""
    },
    {
      "line": "Este es el sacramento de nuestra fe., (Sol,,14)(La,m,335)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "ANUNCIAMOS TU MUERTE, SEÑOR,, (Do,,10)",
      "sC": "ta as"
    },
    {
      "line": "PROCLAMAMOS TU RESURRECCIÓN,, (La,m,326)",
      "sC": "as r7"
    },
    {
      "line": "¡VEN, SEÑOR JESÚS!, (Fa,,10)(Mi,,168)",
      "sC": "as"
    },
    {
      "line": "Memorial y Ofrenda",
      "sC": "ttgray",
      "color": "var(--Referencia-Texto)"
    },
    {
      "line": "Por eso, nosotros, Señor, al celebrar ahora, (La,m,20)",
      "sC": "pa"
    },
    {
      "line": "el memorial de nuestra redención,, (Sol,,182)(La,m,310)",
      "sC": ""
    },
    {
      "line": "recordamos la muerte de Cristo, (Fa,,10)",
      "sC": ""
    },
    {
      "line": "y su descenso al lugar de los muertos,, (La,m,20)",
      "sC": ""
    },
    {
      "line": "proclamamos su resurrección, (Fa,,10)",
      "sC": ""
    },
    {
      "line": "y ascensión a tu derecha;, (Mi,,195)",
      "sC": ""
    },
    {
      "line": "y, mientras esperamos su venida gloriosa,, (Fa,,10)(La,m,290)",
      "sC": ""
    },
    {
      "line": "te ofrecemos su Cuerpo y su Sangre,, (Sol,,12)",
      "sC": ""
    },
    {
      "line": "sacrificio agradabíe a Ti, (La,m,64)",
      "sC": ""
    },
    {
      "line": "y salvación para todo el mundo., (Sol,,87)(La,m,257)",
      "sC": ""
    },
    {
      "line": "Dirige tu mirada sobre esta Víctima, (Do,,10)",
      "sC": ""
    },
    {
      "line": "que tú mismo has preparado a tu Iglesia,, (La,m,360)",
      "sC": ""
    },
    {
      "line": "y concede a cuantos compartimos este pan, (Fa,,64)",
      "sC": ""
    },
    {
      "line": "y este cáliz,, (La,m,84)",
      "sC": ""
    },
    {
      "line": "que, congregados en un solo cuerpo, (Fa,,10)",
      "sC": ""
    },
    {
      "line": "por el Espíritu Santo,, ",
      "sC": ""
    },
    {
      "line": "seamos en Cristo, víctima para tu alabanza., (Mi,,25)",
      "sC": ""
    },
    {
      "line": "ALABANZA DE TU GLORIA,, (Mi7,,13)",
      "sC": "ta as"
    },
    {
      "line": "ALABANZA DE TU GLORIA., ",
      "sC": "as"
    },
    {
      "line": "Intercesiones",
      "sC": "ttgray",
      "color": "var(--Referencia-Texto)"
    },
    {
      "line": "Acuérdate, Señor, de todos aquellos, (La,m,20)(Do,,218)",
      "sC": ""
    },
    {
      "line": "por quienes te ofrecemos este sacrificio;, ",
      "sC": ""
    },
    {
      "line": "de tu servidor el Papa...,(Re,m,22)",
      "sC": ""
    },
    {
      "line": "N/.",
      "sC": "sub adl1",
      "color": "red"
    },
    {
      "line": "de nuestro obispo...",
      "sC": "sub adl2"
    },
    {
      "line": "N/.,",
      "sC": "sub adl3",
      "color": "red"
    },
    {
      "line": "del orden episcopal, de todo el clero, ",
      "sC": ""
    },
    {
      "line": "de cuantos aquí reunidos hacemos esta oblación, ",
      "sC": "width"
    },
    {
      "line": "de todo tu pueblo santo, ",
      "sC": ""
    },
    {
      "line": "y de aquellos que te buscan con sincero corazón., (Mi,,442)",
      "sC": ""
    },
    {
      "line": "Acuérdate también de los que murieron, (La,m,20)(Do,,168)",
      "sC": ""
    },
    {
      "line": "en la paz de Cristo, ",
      "sC": ""
    },
    {
      "line": "y de todos los difuntos cuya fe solo tú conociste., (Re,m,22)(Mi,,423)",
      "sC": ""
    },
    {
      "line": "Conmemoración de los Santos",
      "sC": "ttgray",
      "color": "var(--Referencia-Texto)"
    },
    {
      "line": "Padre misericordioso,, (La,m,20)",
      "sC": ""
    },
    {
      "line": "que todos tus hijos nos reunamos, (Re,m,22)",
      "sC": ""
    },
    {
      "line": "en la heredad de tu reino, ",
      "sC": ""
    },
    {
      "line": "con María, la Virgen Madre de Dios,, (Mi,,145)",
      "sC": ""
    },
    {
      "line": "su esposo san José,, ",
      "sC": ""
    },
    {
      "line": "y con los apóstoles y los santos;, (Re,m,22)(Mi,,250)",
      "sC": ""
    },
    {
      "line": "y allí, junto con toda la creación,, ",
      "sC": ""
    },
    {
      "line": "libre ya del pecado y de la muerte,, (Re,m,22)",
      "sC": ""
    },
    {
      "line": "te glorifiquemos por Cristo, Señor nuestro,, (Mi,,353)",
      "sC": ""
    },
    {
      "line": "por quien concedes al mundo, ",
      "sC": ""
    },
    {
      "line": "todos los bienes., (La,m,114)",
      "sC": ""
    },
    {
      "line": "Doxología y Conclusión de la Plegaria Eucarística,",
      "sC": "ttgray",
      "color": "var(--Referencia-Texto)"
    },
    {
      "line": "Por Cristo, con Cristo y en Cristo,, (Mi7,,16)",
      "sC": ""
    },
    {
      "line": "a ti Dios Padre omnipotente,, (Fa,,10)",
      "sC": ""
    },
    {
      "line": "en la unidad del Espíritu Santo,, (Mi7,,253)",
      "sC": ""
    },
    {
      "line": "todo honor y gloria, (Fa,,10)",
      "sC": ""
    },
    {
      "line": "por los siglos de los siglos., (Mi,,234)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "AMÉN, AMÉN, AMÉN, AMÉN, (Fa,,176)(Mi,,243)",
      "sC": "ta as"
    }
  ],
  "lder": [],
  "sourceBook": "resucito"
}