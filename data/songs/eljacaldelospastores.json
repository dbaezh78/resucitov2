  "lizq": [
    {
      "line": "Que me bese con besos de su boca,,(Re,m,21)",
      "sC": "tc"
    },
    {
      "line": "mejores son que el vino tus amores. (Si♭,,89)(La,,278)",
      "sC": ""
    },
    {
      "line": "Tu nombre es ungüento que se vierte,",
      "sC": ""
    },
    {
      "line": "por eso te aman las doncellas., (Re,m,254)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "LLÉVAME EN POS DE TI, SALGAMOS., (Re,m,21)",
      "sC": "ta as"
    },
    {
      "line": "LLÉVAME TRAS DE TI, CORRAMOS., (Si♭,,89)(La,,278)",
      "sC": "as"
    },
    {
      "line": "CELEBRAREMOS TUS AMORES MÁS QUE EL VINO, ",
      "sC": "as"
    },
    {
      "line": "CON CUÁNTA RAZÓN ERES AMADO., (Re,m,300)",
      "sC": "as"
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "HAZME SABER, AMADO DE MI ALMA,, (Re,m,23)",
      "sC": "as r1"
    },
    {
      "line": "DÓNDE APACIENTAS EL REBAÑO,, (La,,280)",
      "sC": "as"
    },
    {
      "line": "PARA QUE YO NO ANDE VAGABUNDA, ",
