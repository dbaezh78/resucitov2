    },
    {
      "line": "Como el impulso que siente la ira, (Do,,10)(La,m,250)",
      "sC": "tc"
    },
    {
      "line": "hacia el enemigo,, (Re,m,22)",
      "sC": ""
    },
    {
      "line": "como el impulso que siente el amor, (Sol,7,14)",
      "sC": ""
    },
    {
      "line": "hacia el amado,, (Do,,10)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "así siento yo un impulso hacia Ti,, (La,7,20)(Re,m,250)",
      "sC": ""
    },
    {
      "line": "Tú, el inmortal, la plenitud de los tiempos., (Sol,,14)(Do,,250)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "TÚ ERES EL CAMINO,, (La,m,164)",
      "sC": "ta as"
    },
    {
      "line": "¡CÓMO ES MARAVILLOSO!, (Mi,,210)",
      "sC": "as"
    },
    {
      "line": "TÚ ERES EL CAMINO, TÚ ERES EL AMOR., (La,m,360)",
      "sC": "as"
    },
    {
      "line": "TÚ ERES EL CAMINO, TÚ ERES LA VIDA., (Sol,,161)(La,m,337)",
      "sC": "as"
