      "sC": "as"
    },
    {
      "line": "TÚ ERES LA VIDA., (Mi,,130)",
      "sC": "as"
    }
  ],
  "lder": [
    {
      "line": "Te has entregado a mí sin ninguna reserva,, (Do,,10)(La,m,209)(Re,m,373)",
      "sC": "tc"
    },
    {
      "line": "lleno de suavidad, (Sol,7,153)",
      "sC": ""
    },
    {
      "line": "hiciste pequeña tu grandeza., (Do,,241)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Te hiciste pecado por mí lleno de misericordia,, (La,7,20)(Re,m,397)",
      "sC": ""
    },
    {
      "line": "para que mis pecados no me apartasen de Ti., (Sol,,14)(Do,,428)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
