  "lder": [
    {
      "line": "Te aconsejo que me compres, (Mi,m,15)",
      "sC": "tc"
    },
    {
      "line": "oro acrisolado al fuego,,(Sol,,10)",
      "sC": ""
    },
    {
      "line": "para que te enriquezcas,,(Re,7,183)",
      "sC": ""
    },
    {
      "line": "y vestidos blancos, (Si,7,126)",
      "sC": ""
    },
    {
      "line": "para cubrir tu desnudez., (Mi,m,211)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Mira que estoy a la puerta y llamo;, (Mi,m,21)",
      "sC": ""
    },
