    {
      "line": "no eres ni frío ni caliente., (Sol,,38)",
      "sC": ""
    },
    {
      "line": "¡Ojalá fueras frío o caliente, (Re,7,221)",
      "sC": ""
    },
    {
      "line": "y no tibio!, (Si,7,58)",
      "sC": ""
    },
    {
      "line": "Porque voy a vomitarte de mi boca., (Mi,m,304)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Tú dices: «Yo soy rico, nada me falta»,,(Mi,m,22)",
      "sC": ""
    },
    {
      "line": "y no te das cuenta, (Sol,,15)",
      "sC": ""
    },
    {
      "line": "que eres un desgraciado,,(Re,7,203)",
      "sC": ""
    },
    {
      "line": "digno de compasión,,(Si,7,177)",
      "sC": ""
    },
    {
      "line": "pobre, ciego y desnudo., (Mi,m,192)",
      "sC": ""
