    },
    {
      "line": "Confía en el Señor y haz el bien,, (La,m,20)(Fa,,282)",
      "sC": "tc"
    },
    {
      "line": "habita tu tierra y sé leal,, (Mi,,214)",
      "sC": ""
    },
    {
      "line": "sea el Señor tu delicia, (Re,m,108)(Mi,,181)",
      "sC": ""
    },
    {
      "line": "y él te dará lo que ansía tu corazón., (Fa,,99)(Mi,,315)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Encomienda tu camino al Señor, (La,m,20)",
      "sC": ""
    },
    {
      "line": "y espera en Él,, (Fa,,125)",
      "sC": ""
    },
    {
      "line": "confía en Él, que actuará;, (Mi,,232)",
      "sC": ""
    },
    {
      "line": "hará brillar tu justicia,, (Re,m,93)(Mi,,172)",
      "sC": ""
    },
    {
      "line": "hará brillar tu lealtad., (Fa,,90)(Mi,,183)",
      "sC": ""
    },
