  "lder": [
    {
      "line": "Cohíbe tu ira, reprime el coraje,, (La,m,20)(Fa,,271)",
      "sC": "tc"
    },
    {
      "line": "no te exasperes, no sea que obres mal;, (Mi,,353)",
      "sC": ""
    },
    {
      "line": "los que obran mal son excluidos,, (Re,m,155)(Mi,,271)",
      "sC": ""
    },
    {
      "line": "los que esperan en el Señor, (Fa,,112)",
      "sC": ""
    },
    {
      "line": "en la tierra entrarán., (Mi,,175)",
