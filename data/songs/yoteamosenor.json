    {
      "line": "Clamé al Señor en mi angustia,, (Fa#,,15)",
      "sC": "tc"
    },
    {
      "line": "a mi Dios, a mi Dios invoqué,, (Si,m,263)",
      "sC": ""
    },
    {
      "line": "y escuchó mi voz desde su templo,, (La,,11)(Sol,,274)",
      "sC": ""
    },
    {
      "line": "llegó mi llamada a sus oídos., (Fa#,,234)",
      "sC": ""
    },
    {
      "line": "",
      "sC": "adb1"
    },
    {
      "line": "Y la tierra fue sacudida y vaciló,, (Sol,,58)(Fa#,,290)",
      "sC": ""
    },
    {
      "line": "retemblaron las bases de los montes., (Sol,,91)(Fa#,,304)",
      "sC": ""
    },
    {
      "line": "Porque inclinó los cielos y bajó., (Sol,,14)(Fa#,,284)",
      "sC": "melisma"
    }
  ],
  "lder": [
    {
      "line": "Y el fondo del mar quedó a la vista,, (La,,10)(Fa#,,299)",
      "sC": ""
    },
    {
      "line": "los cimientos del orbe aparecieron., (La,,79)(Fa#,,294)",
      "sC": ""
    },
    {
      "line": "Extendió su mano para asirme,, (Sol,,77)",
      "sC": ""
    },
    {
      "line": "me sacó de lo profundo de las aguas., (Fa#,,306)",
