    {
      "line": "Bendita eres tú, María,,(La,m,15)(Sol,,138)(La,m,196)",
      "sC": "tc"
    },
    {
      "line": "entre todas las mujeres, María., (Sol,,193)(La,m,278)",
      "sC": ""
    },
    {
