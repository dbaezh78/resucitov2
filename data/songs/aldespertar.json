    {
      "line": "ME SACIARÉ DE TU SEMBLANTE, SEÑOR., (Si,m,261)",
      "sC": "as"
    },
    {
      "line": "Escucha, Señor, mi oración,(Mi,m,15)(Si,m,241)",
      "sC": "mt tc"
    },
    {
      "line": "atiende, Señor, a mi clamor., (Mi,m,15)(Si,m,250)",
      "sC": ""
    },
    {
      "line": "Presta oídos a mi súplica,(Sol,,11)(Fa#,,188)",
      "sC": ""
    },
    {
      "line": "que mis labios no traicionan, Señor,(Sol,,96)(Fa#,,322)",
      "sC": ""
    },
    {
      "line": "salga de ti la sentencia., (Sol,,11)(Fa#,,175)",
      "sC": ""
    },
    {
      "line": "Porque tus ojos ven, tus ojos ven mi rectitud., (Mi,m,119)(Fa#,,404)",
      "sC": ""
    },
    {
