    {
      "line": "Cantad al Señor un cantar nuevo,, (La,m,22)(Si,7,289)",
      "sC": "tc"
    },
    {
      "line": "tocad la cítara con arte y aclamadle., (La,m,21)(Si,7,317)",
      "sC": ""
    },
    {
      "line": "Porque recta es la palabra del Señor,, (Do,,10)",
      "sC": ""
    },
    {
      "line": "verdad son todas sus obras., (Re,,10)(Si,7,222)",
      "sC": ""
    },
    {
      "line": "En Él están la justicia y el derecho,, (Do,,10)",
      "sC": ""
    },
    {
